{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://pardo.ai/schemas/project-governance.v1.json",
  "title": "PARDO ProjectGovernance",
  "type": "object",
  "additionalProperties": false,
  "required": ["apiVersion", "kind", "metadata", "spec"],
  "properties": {
    "apiVersion": { "const": "pardo.ai/v0" },
    "kind": { "const": "ProjectGovernance" },
    "metadata": { "$ref": "#/$defs/metadata" },
    "spec": { "$ref": "#/$defs/spec" }
  },
  "$defs": {
    "id": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[a-z][a-z0-9-]*$"
    },
    "capabilityId": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[a-z][a-z0-9]*(?:\\.[a-z][a-z0-9]*)*$"
    },
    "capabilityVersion": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
    },
    "capabilityRef": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9]*(?:\\.[a-z][a-z0-9]*)*@[0-9]+\\.[0-9]+\\.[0-9]+$"
    },
    "metadata": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "name", "version", "status"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "name": { "type": "string", "minLength": 1 },
        "version": { "$ref": "#/$defs/capabilityVersion" },
        "status": { "type": "string", "minLength": 1 }
      }
    },
    "spec": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "modelPolicy",
        "defaults",
        "agents",
        "resources",
        "capabilityRegistry",
        "grants"
      ],
      "properties": {
        "modelPolicy": { "$ref": "#/$defs/modelPolicy" },
        "defaults": { "$ref": "#/$defs/defaults" },
        "agents": { "$ref": "#/$defs/agents" },
        "resources": { "$ref": "#/$defs/resources" },
        "capabilityRegistry": { "$ref": "#/$defs/capabilityRegistry" },
        "grants": { "$ref": "#/$defs/grants" }
      }
    },
    "modelPolicy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["defaultClass", "provider", "selection"],
      "properties": {
        "defaultClass": { "type": "string", "minLength": 1 },
        "provider": { "type": "string", "minLength": 1 },
        "selection": { "type": "string", "minLength": 1 }
      }
    },
    "defaults": {
      "type": "object",
      "additionalProperties": false,
      "required": ["sandbox", "skills", "capabilities"],
      "properties": {
        "sandbox": { "$ref": "#/$defs/sandbox" },
        "skills": { "$ref": "#/$defs/stringAllowlist" },
        "capabilities": { "$ref": "#/$defs/stringAllowlist" }
      }
    },
    "sandbox": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "required",
        "isolationScope",
        "workspaceAccess",
        "network",
        "elevated"
      ],
      "properties": {
        "required": { "type": "boolean" },
        "isolationScope": { "type": "string", "minLength": 1 },
        "workspaceAccess": { "type": "string", "minLength": 1 },
        "network": { "type": "string", "minLength": 1 },
        "elevated": { "type": "boolean" }
      }
    },
    "stringAllowlist": {
      "type": "object",
      "additionalProperties": false,
      "required": ["allow"],
      "properties": {
        "allow": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        }
      }
    },
    "agents": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": { "$ref": "#/$defs/agent" },
      "propertyNames": { "$ref": "#/$defs/id" }
    },
    "agent": {
      "type": "object",
      "additionalProperties": false,
      "required": ["role", "orchestration", "mutations", "delegation"],
      "properties": {
        "role": {
          "type": "string",
          "enum": ["coordinator", "auditor", "operator"]
        },
        "orchestration": {
          "type": "string",
          "enum": ["root", "leaf"]
        },
        "mutations": {
          "type": "string",
          "enum": ["deny", "approval-required"]
        },
        "delegation": { "$ref": "#/$defs/delegation" }
      }
    },
    "delegation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["allow", "requireExplicitTarget"],
      "properties": {
        "allow": {
          "type": "array",
          "items": { "$ref": "#/$defs/id" }
        },
        "requireExplicitTarget": { "type": "boolean" }
      }
    },
    "resources": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": { "$ref": "#/$defs/resource" },
      "propertyNames": { "$ref": "#/$defs/id" }
    },
    "resource": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type"],
      "properties": {
        "type": {
          "type": "string",
          "minLength": 1,
          "pattern": "^[a-z][a-z0-9-]*$"
        }
      }
    },
    "capabilityRegistry": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": { "$ref": "#/$defs/capabilityRecord" },
      "propertyNames": { "$ref": "#/$defs/capabilityRef" }
    },
    "capabilityRecord": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "version"],
      "properties": {
        "id": { "$ref": "#/$defs/capabilityId" },
        "version": { "$ref": "#/$defs/capabilityVersion" }
      }
    },
    "grants": {
      "type": "array",
      "items": { "$ref": "#/$defs/grant" }
    },
    "grant": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "agentId", "action", "capability", "resourceRef"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "agentId": { "$ref": "#/$defs/id" },
        "action": { "type": "string", "enum": ["execute"] },
        "capability": { "$ref": "#/$defs/capabilityRef" },
        "resourceRef": { "$ref": "#/$defs/id" }
      }
    }
  }
}
