{
  "apiVersion": "pardo.ai/v0",
  "kind": "ProjectGovernance",
  "metadata": {
    "id": "pardo-infra",
    "name": "PARDO Infra Governance",
    "version": "1.0.0",
    "status": "experimental"
  },
  "spec": {
    "modelPolicy": {
      "defaultClass": "project-default",
      "provider": "openai",
      "selection": "runtime-default"
    },
    "defaults": {
      "sandbox": {
        "required": true,
        "isolationScope": "agent",
        "workspaceAccess": "none",
        "network": "none",
        "elevated": false
      },
      "skills": {
        "allow": []
      },
      "capabilities": {
        "allow": []
      }
    },
    "agents": {
      "infra-control": {
        "role": "coordinator",
        "orchestration": "root",
        "mutations": "deny",
        "delegation": {
          "allow": [
            "infra-auditor",
            "infra-operator"
          ],
          "requireExplicitTarget": true
        }
      },
      "infra-auditor": {
        "role": "auditor",
        "orchestration": "leaf",
        "mutations": "deny",
        "delegation": {
          "allow": [],
          "requireExplicitTarget": true
        }
      },
      "infra-operator": {
        "role": "operator",
        "orchestration": "leaf",
        "mutations": "approval-required",
        "delegation": {
          "allow": [],
          "requireExplicitTarget": true
        }
      }
    },
    "resources": {
      "nas-primary": {
        "type": "storage-system"
      }
    },
    "capabilityRegistry": {
      "storage.health@1.0.0": {
        "id": "storage.health",
        "version": "1.0.0"
      }
    },
    "grants": [
      {
        "id": "infra-auditor-storage-health-nas-primary",
        "agentId": "infra-auditor",
        "action": "execute",
        "capability": "storage.health@1.0.0",
        "resourceRef": "nas-primary"
      }
    ]
  }
}
